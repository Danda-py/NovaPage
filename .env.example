# Database Postgres (Neon) · connection string pooled
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Segreto per firmare i cookie di sessione · obbligatorio in produzione
# Genera con: openssl rand -hex 32
AUTH_SECRET=

# Gemini · generazione e modifica delle pagine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Storage immagini su Vercel Blob · obbligatorio in produzione
# Senza token gli upload finiscono su public/uploads (solo sviluppo locale)
BLOB_READ_WRITE_TOKEN=

# Email transazionali (reset password) · Resend
RESEND_API_KEY=
EMAIL_FROM=NovaPage <no-reply@tuodominio.it>
# Dove arrivano gli avvisi di errore (uno ogni 10 minuti per origine)
ADMIN_EMAIL=

# URL pubblico, usato da sitemap, OpenGraph e link nelle email
NEXT_PUBLIC_SITE_URL=https://novapage.site

# Sale dell'hash con cui si contano i visitatori unici (IP + giorno, mai salvato in chiaro)
# Genera con: openssl rand -hex 16 · senza valore usa "novapage", prevedibile
ANALYTICS_SALT=

# Solo per ambienti di test: consente upload su disco con NODE_ENV=production
# ALLOW_LOCAL_UPLOADS=1
